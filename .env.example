# Copy to .env and fill in real values. PUID, PGID and HOST_HOME have no
# defaults on purpose: compose fails fast rather than mounting the wrong path or
# running as root. The README has a snippet that generates this file correctly:
#
#   mkdir -p "$HOME/.codex" "$HOME/.codex-switch"
#   chmod 700 "$HOME/.codex" "$HOME/.codex-switch"
#   cat > .env <<EOF
#   PUID=$(id -u)
#   PGID=$(id -g)
#   HOST_HOME=$HOME
#   TZ=Asia/Shanghai
#   EOF

# UID/GID of the host user that owns ~/.codex and ~/.codex-switch and runs Codex CLI.
#   id -u
PUID=
#   id -g
PGID=

# Absolute path to that user's home directory (no ~ expansion in compose files).
#   echo "$HOME"
HOST_HOME=

# Container timezone. five_hour_warmup_times ("05:00", "10:10", "15:20") is
# matched against local time inside the container, so set this to the timezone
# those hours are meant for.
TZ=Asia/Shanghai
